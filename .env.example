# `npm run env` fills in the Supabase values from the local stack.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (from `npx supabase status`, or Project Settings > API Keys when hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Stripe. Leave STRIPE_SECRET_KEY empty in development to use the built-in simulator.
# Prefer a restricted key (rk_test_...) with write access to Customers, Checkout
# Sessions, Customer portal and read access to Subscriptions and Charges.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_local_simulator_secret
# Written by `npm run stripe:setup`.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PORTAL_CONFIGURATION=

# Set to true to allow the simulator in a production build (demo deployments only).
BILLING_SIMULATOR=

# Optional: email invitations through Resend. Without these, admins copy the invite link.
RESEND_API_KEY=
EMAIL_FROM=
